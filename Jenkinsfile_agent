# Utilizando una imagen de docker para compilar
pipeline {
    agent {
                docker { image 'node:lts-buster'
                         args ' --user root -v $PWD:/usr/src/app -w /usr/src/app' }
        }
        environment {
            FOLDER = "ReactJs/03-counter-app"
        }
    stages {
        stage('Init') {
            steps {
                sh ''' 
                    rm -r ReactJs
                    git clone https://github.com/xxluiggixx/ReactJs.git
                    cd $FOLDER
                    npm install
                '''
            }
        }
        stage('test') {
            steps {
                dir('$FOLDER'){
                    sh 'npm test'
                }
            }
        }
        stage('Deploy') {
            steps {
               echo 'Deploy...'
            }
        }

    }//end stages
}//end pipeline